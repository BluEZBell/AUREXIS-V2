# ==========================================
# AUREXIS PROP-FIRM ALGORITHMIC TRADING SYSTEM
# Configuration & Credentials (Environment Variables)
# ==========================================

# 1. MT5 CREDENTIALS (MANDATORY FOR LIVE TRADING)
MT5_LOGIN=12345678
MT5_PASSWORD=your_secure_password
MT5_SERVER=Broker-Server
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# 2. TELEMETRY & ALERTS (TELEGRAM)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEMETRY_WEBHOOK_URL=

# 3. CORE TRADING PARAMETERS
MAGIC_NUMBER=777999
TRADING_SYMBOL=GOLD
PROFILE_MODE=UNLIMITED_APEX
MAX_DAILY_LOSS_PCT=6.5
MAX_OPEN_POSITIONS=5
WEB_PORT=8000

# WARNING: NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL

# 4. DAILY CALIBRATION (Decoupled Hyperparameters)
MAX_GLOBAL_DRAWDOWN=5.0
BASE_LOT_SIZE=0.01
ASYMMETRIC_KELLY_MULTIPLIER=1.25
BASELINE_SPREAD_LIMIT=1.5
TOXIC_SLIPPAGE_THRESHOLD=3.0
WEB_DASHBOARD_PORT=8000
